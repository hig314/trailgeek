# Copy to .env (mode 600 in production). Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8002
# Production:
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=trailgeek.org,www.trailgeek.org
# DJANGO_CSRF_TRUSTED_ORIGINS=https://trailgeek.org,https://www.trailgeek.org

POSTGRES_DB=trailgeek
POSTGRES_USER=trailgeek
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
# HUEY_IMMEDIATE=1   # run tasks inline without Redis or a worker (quick local look only)

# Email, only for password-reset links. Leave EMAIL_HOST empty and the message
# is printed to the web container's log instead (docker compose logs web).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=trailgeek <noreply@trailgeek.org>

# Caddy (production only): the domain it serves and gets a certificate for.
SITE_DOMAIN=trailgeek.org
ACME_EMAIL=hig314@gmail.com
